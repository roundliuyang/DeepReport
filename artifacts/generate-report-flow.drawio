          <mxGeometry x="920" y="560" width="340" height="92" as="geometry" />
        </mxCell>
        <mxCell id="blocked" value="有失败依赖：跳过 Agent&#10;记录 success=False&#10;error = Failed dependencies" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#EAF0F5;strokeColor=#7C91A5;strokeWidth=1.5;fontColor=#263548;fontSize=14;fontFamily=Helvetica;spacing=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="920" y="710" width="340" height="92" as="geometry" />
        </mxCell>
        <mxCell id="context" value="无失败依赖：构造 context&#10;主题 + 要求 + 直接 / 间接依赖结果&#10;不传入无关任务分支" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#EAF0F5;strokeColor=#7C91A5;strokeWidth=1.5;fontColor=#263548;fontSize=14;fontFamily=Helvetica;spacing=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="920" y="850" width="340" height="92" as="geometry" />
        </mxCell>
        <mxCell id="dispatch" value="asyncio.gather 执行本批 ready&#10;信号量内：_execute_agent_task()&#10;按 task_type 创建独立 Agent / 模型" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#EAF0F5;strokeColor=#7C91A5;strokeWidth=1.5;fontColor=#263548;fontSize=14;fontFamily=Helvetica;spacing=10;align=center;verticalAlign=middle;" vertex="1" parent="1">

        <mxCell id="click" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E9F4EB;strokeColor=#62916E;fontColor=#263548;fontSize=15;fontFamily=Helvetica;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.5;" value="01  点击 Generate Report&#10;research_topic · requirements · output_format · model" vertex="1">
          <mxGeometry x="90" y="310" width="440" height="100" as="geometry" />
        </mxCell>
        <mxCell id="interface" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E9F4EB;strokeColor=#62916E;fontColor=#263548;fontSize=15;fontFamily=Helvetica;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.5;" value="02  generate_report_interface()&#10;await app.generate_report(...)" vertex="1">
          <mxGeometry x="90" y="460" width="440" height="100" as="geometry" />
        </mxCell>
        <mxCell id="scope" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E9F4EB;strokeColor=#62916E;fontColor=#263548;fontSize=15;fontFamily=Helvetica;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.5;" value="03  请求隔离&#10;copy.copy(self)；按选择模型读取配置&#10;独立 agents + ResearchTrace；初始化 Agent" vertex="1">
          <mxGeometry x="90" y="610" width="440" height="120" as="geometry" />
        </mxCell>
        <mxCell id="plan" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E8F0FC;strokeColor=#6D8FC4;fontColor=#263548;fontSize=15;fontFamily=Helvetica;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.5;" value="04  _generate_report()：解析逐行要求&#10;直接 model.generate() 请求研究计划 JSON&#10;剥离代码围栏 → json.loads → 检查 tasks 列表" vertex="1">
          <mxGeometry x="670" y="610" width="440" height="120" as="geometry" />
        </mxCell>
        <mxCell id="validate" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E8F0FC;strokeColor=#6D8FC4;fontColor=#263548;fontSize=15;fontFamily=Helvetica;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.5;" value="05  校验计划&#10;任务非空；ID 唯一；handler 类型合法&#10;parameters=dict；dependencies=list&#10;所有依赖 ID 必须存在" vertex="1">
          <mxGeometry x="670" y="790" width="440" height="130" as="geometry" />
        </mxCell>
        <mxCell id="ready" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E8F0FC;strokeColor=#6D8FC4;fontColor=#263548;fontSize=15;fontFamily=Helvetica;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.5;" value="06  pending → 计算 ready&#10;依赖均已有结果的任务才可进入本批&#10;ready 为空且仍有 pending → 依赖环异常" vertex="1">
          <mxGeometry x="670" y="980" width="440" height="120" as="geometry" />
        </mxCell>
        <mxCell id="dispatch" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E8F0FC;strokeColor=#6D8FC4;fontColor=#263548;fontSize=15;fontFamily=Helvetica;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.5;" value="07  对 ready 任务逐项 await（非并发）&#10;依赖失败 → 记失败，跳过 handler&#10;否则 prepared.context 包含主题、要求、&#10;所有已完成且成功的 task_results" vertex="1">
          <mxGeometry x="670" y="1160" width="440" height="140" as="geometry" />
        </mxCell>
        <mxCell id="search" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E6F4F2;strokeColor=#5E9E98;fontColor=#263548;fontSize=15;fontFamily=Helvetica;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.5;" value="08A  search_queries() → 依次补搜&#10;query 首个意图 → 完整主题 → 补充查询&#10;经济主题追加 IMF / World Bank 限定" vertex="1">
          <mxGeometry x="1250" y="1380" width="440" height="120" as="geometry" />
        </mxCell>
        <mxCell id="discover" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E6F4F2;strokeColor=#5E9E98;fontColor=#263548;fontSize=15;fontFamily=Helvetica;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.5;" value="SourceDiscoveryTool.forward()&#10;SerpAPI：每次最多 10 条结果&#10;选尚未访问 URL，最多 5 个&#10;无新 URL → 下一查询" vertex="1">
          <mxGeometry x="1250" y="1560" width="440" height="120" as="geometry" />
        </mxCell>
        <mxCell id="extract" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E6F4F2;strokeColor=#5E9E98;fontColor=#263548;fontSize=15;fontFamily=Helvetica;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.5;" value="ContentExtractionTool.forward()&#10;提取网页 / PDF 正文，最多 12000 字符&#10;单 URL 提取失败可跳过&#10;随后将候选正文送至 _review_sources" vertex="1">
          <mxGeometry x="1250" y="1740" width="440" height="140" as="geometry" />
        </mxCell>
        <mxCell id="accepted" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E6F4F2;strokeColor=#5E9E98;fontColor=#263548;fontSize=15;fontFamily=Helvetica;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.5;" value="累积相关正文，按 URL 去重&#10;≥ 2 份 → 提前停止补搜&#10;不足 2 份 → 还有查询则补搜&#10;查询耗尽后，≥ 1 份即可成功" vertex="1">
          <mxGeometry x="1250" y="2180" width="440" height="140" as="geometry" />
        </mxCell>
        <mxCell id="searchresult" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E6F4F2;strokeColor=#5E9E98;fontColor=#263548;fontSize=15;fontFamily=Helvetica;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.5;" value="检索任务返回&#10;success / task_type=deep_research&#10;results + structured_data.extracted_content&#10;没有相关正文 / 处理器异常 → 失败" vertex="1">
          <mxGeometry x="1250" y="2400" width="440" height="130" as="geometry" />
        </mxCell>
        <mxCell id="browser" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#EAF0F5;strokeColor=#7C91A5;fontColor=#263548;fontSize=15;fontFamily=Helvetica;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.5;" value="08B  规范参数与动作&#10;区分只读 / exact_target / 交互&#10;固定目标和交互必须有明确 URL / PDF&#10;无效参数或缺少必要目标 → 失败" vertex="1">
          <mxGeometry x="1830" y="1380" width="440" height="120" as="geometry" />
        </mxCell>
        <mxCell id="targets" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#EAF0F5;strokeColor=#7C91A5;fontColor=#263548;fontSize=15;fontFamily=Helvetica;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.5;" value="目标选择与有界恢复&#10;有目标：先读取原目标&#10;无目标：上游 URL 最多 3 个 → 再搜最多 5 个&#10;仅普通只读可换源；保留域名 / PDF 约束" vertex="1">
          <mxGeometry x="1830" y="1560" width="440" height="140" as="geometry" />
        </mxCell>
        <mxCell id="fetch" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#EAF0F5;strokeColor=#7C91A5;fontColor=#263548;fontSize=15;fontFamily=Helvetica;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.5;" value="BrowserAgent.execute_task()&#10;网页导航 / 结构提取 / 表单：Playwright&#10;PDF：PDFAnalysisTool&#10;非 PDF 任务 finally 关闭浏览器" vertex="1">
          <mxGeometry x="1830" y="1800" width="440" height="130" as="geometry" />
        </mxCell>
        <mxCell id="content" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#EAF0F5;strokeColor=#7C91A5;fontColor=#263548;fontSize=15;fontFamily=Helvetica;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.5;" value="验证工具成功且正文非空&#10;full_text / content / result_content&#10;或非空 extracted_data&#10;再调用 _review_sources 判断相关性" vertex="1">
          <mxGeometry x="1830" y="1990" width="440" height="140" as="geometry" />
        </mxCell>
        <mxCell id="browserresult" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#EAF0F5;strokeColor=#7C91A5;fontColor=#263548;fontSize=15;fontFamily=Helvetica;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.5;" value="浏览器任务返回&#10;通过 → results + extracted_content&#10;失败 → 记录尝试，允许时换候选重试&#10;固定目标 / 交互失败、候选耗尽 → 失败" vertex="1">
          <mxGeometry x="1830" y="2400" width="440" height="130" as="geometry" />
        </mxCell>
        <mxCell id="review" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#F0EBFA;strokeColor=#9980C4;fontColor=#263548;fontSize=15;fontFamily=Helvetica;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.5;" value="09  review_sources(model, topic, task, items)&#10;候选使用原始 URL、标题与前 7000 字符&#10;直接 model.generate() 判断内容相关性" vertex="1">
          <mxGeometry x="2410" y="1990" width="440" height="140" as="geometry" />
        </mxCell>
        <mxCell id="decision" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#F0EBFA;strokeColor=#9980C4;fontColor=#263548;fontSize=15;fontFamily=Helvetica;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.5;" value="解析审查 JSON&#10;只接受 relevant=true 且 ID 匹配的候选&#10;排除通知、登录、无关百科、无研究结论的议程&#10;返回正文 + relevance_reason" vertex="1">
          <mxGeometry x="2410" y="2180" width="440" height="140" as="geometry" />
        </mxCell>
        <mxCell id="reviewnote" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#EAF0F5;strokeColor=#7C91A5;fontColor=#263548;fontSize=15;fontFamily=Helvetica;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.5;" value="共享证据入口&#10;HTTP 成功不等于证据合格。&#10;搜索与浏览器都经过此模块。&#10;来源审查结果不直接生成分析结论。" vertex="1">
          <mxGeometry x="2410" y="1510" width="440" height="145" as="geometry" />
        </mxCell>
        <mxCell id="write" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#F0EBFA;strokeColor=#9980C4;fontColor=#263548;fontSize=15;fontFamily=Helvetica;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.5;" value="08C  ResearchWriter.write(task, stage)&#10;deep_analyze → analysis&#10;final_answer → final&#10;按主题区分宏观与其他研究" vertex="1">
          <mxGeometry x="2990" y="1380" width="440" height="120" as="geometry" />
        </mxCell>
        <mxCell id="catalog" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#F0EBFA;strokeColor=#9980C4;fontColor=#263548;fontSize=15;fontFamily=Helvetica;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.5;" value="collect_evidence() + index_evidence()&#10;从 context.task_results 汇总成功任务正文&#10;并纳入参数中提供的 supplied data&#10;正文按 1200 字符切片 → 稳定 evidence_id&#10;没有证据 → 立即失败" vertex="1">
          <mxGeometry x="2990" y="1560" width="440" height="140" as="geometry" />
        </mxCell>
        <mxCell id="draft" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#F0EBFA;strokeColor=#9980C4;fontColor=#263548;fontSize=15;fontFamily=Helvetica;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.5;" value="10  组装提示并 model.generate()&#10;主题 + 要求 + 任务 + evidence catalog&#10;附带此前所有分析文档；中文主题用中文&#10;final 阶段要求综合来源与分析形成结论" vertex="1">
          <mxGeometry x="2990" y="1760" width="440" height="140" as="geometry" />
        </mxCell>
        <mxCell id="quality" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#F0EBFA;strokeColor=#9980C4;fontColor=#263548;fontSize=15;fontFamily=Helvetica;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.5;" value="11  JSON 解析与 validate()&#10;摘要 / 不重复章节 / 实质正文 / limitations&#10;每节 evidence_id 必须来自 catalog&#10;回填原始 URL + quote；检查宏观指标适配" vertex="1">
          <mxGeometry x="2990" y="1970" width="440" height="150" as="geometry" />
        </mxCell>
        <mxCell id="retry" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#FFF4DA;strokeColor=#B99C55;fontColor=#263548;fontSize=15;fontFamily=Helvetica;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.5;" value="解析 / 校验失败&#10;首次：附上具体错误，要求纠正 JSON&#10;第二次：任务失败；不发布状态文案&#10;模型调用异常不走这条纠正循环" vertex="1">
          <mxGeometry x="2990" y="2180" width="440" height="140" as="geometry" />
        </mxCell>
        <mxCell id="writerresult" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#F0EBFA;strokeColor=#9980C4;fontColor=#263548;fontSize=15;fontFamily=Helvetica;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.5;" value="写作任务返回&#10;research_document + render_text()&#10;analysis → agent_response&#10;final 另加 report_content / format=text" vertex="1">
          <mxGeometry x="2990" y="2400" width="440" height="130" as="geometry" />
        </mxCell>
        <mxCell id="collect" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E8F0FC;strokeColor=#6D8FC4;fontColor=#263548;fontSize=15;fontFamily=Helvetica;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.5;" value="12  收集 handler 返回结果或异常&#10;写 task_results[task_id]；删除 pending 项&#10;完成本批后重新计算 ready&#10;下游依赖失败时直接记录 Failed dependencies" vertex="1">
          <mxGeometry x="670" y="2620" width="440" height="140" as="geometry" />
        </mxCell>

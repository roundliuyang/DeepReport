        </mxCell>
        <mxCell id="collected" value="等待本批所有任务结束&#10;成功或异常均形成 task_results&#10;写入 results，并从 pending 删除" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#EAF0F5;strokeColor=#7C91A5;strokeWidth=1.5;fontColor=#263548;fontSize=14;fontFamily=Helvetica;spacing=10;align=center;verticalAlign=middle;" vertex="1" parent="1">

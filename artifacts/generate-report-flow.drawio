        <mxCell id="sched_init" value="再次校验任务图&#10;pending = 全部任务；results = {}&#10;Semaphore(2)：最多两个任务执行" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#EAF0F5;strokeColor=#7C91A5;strokeWidth=1.5;fontColor=#263548;fontSize=14;fontFamily=Helvetica;spacing=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
